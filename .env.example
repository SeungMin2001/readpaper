# Copy to .env for local Docker use. Never commit .env.
READPAPER_USERNAME=reader
READPAPER_PASSWORD=replace-with-a-long-unique-password
READPAPER_SESSION_SECRET=replace-with-a-long-random-secret
READPAPER_SECURE_COOKIES=0
READPAPER_DEV_MODE=0
# vLLM OpenAI-compatible server. The default host name is for Docker Desktop on a Mac.
READPAPER_LLM_BASE_URL=http://host.docker.internal:8001/v1
READPAPER_LLM_MODEL=gemma4-12b
# Set this to the same key passed to `vllm serve --api-key`.
READPAPER_LLM_API_KEY=
# Optional metadata/OA lookup credentials; add these to .env for higher API reliability.
READPAPER_OPENALEX_API_KEY=
READPAPER_UNPAYWALL_EMAIL=
READPAPER_CROSSREF_EMAIL=
# Only required with compose.prod.yaml; point this name at the cloud server.
READPAPER_DOMAIN=reader.example.com
# Mac mini E5 embedding API. In production use its private VPN address.
READPAPER_EMBEDDING_MODEL=intfloat/multilingual-e5-small
READPAPER_EMBEDDING_BASE_URL=http://host.docker.internal:8002/v1
READPAPER_EMBEDDING_API_KEY=
# Qdrant runs in this project's Docker Compose network.
READPAPER_QDRANT_URL=http://qdrant:6333
